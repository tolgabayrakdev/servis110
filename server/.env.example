NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servis110
JWT_SECRET=change-this-with-at-least-32-characters
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=servis110_access_token
AUTH_COOKIE_MAX_AGE_MS=86400000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Parola sıfırlama e-postaları (geliştirmede SMTP_HOST boşsa bağlantı konsola yazılır)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test
